<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusXchange</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="container py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">My Dashboard</h4>
      <p class="text-muted small mb-0">Hello, <%= user.name.split(' ')[0] %>! Here's your activity overview.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/listings/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Post New Listing
      </a>
      <a href="/inquiries/sent" class="btn btn-outline-primary">
        <i class="bi bi-envelope me-2"></i>My Inquiries
      </a>
    </div>
  </div>

  <!-- Stats -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-1 text-center">
        <div class="card-body py-3">
          <div class="stat-icon-sm bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-2">
            <i class="bi bi-tag fs-5"></i>
          </div>
          <div class="fs-3 fw-bold text-primary"><%= stats.activeCount %></div>
          <div class="text-muted small">Active Listings</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-1 text-center">
        <div class="card-body py-3">
          <div class="stat-icon-sm bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-2">
            <i class="bi bi-bag-check fs-5"></i>
          </div>
          <div class="fs-3 fw-bold text-success"><%= stats.soldCount %></div>
          <div class="text-muted small">Sold</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-1 text-center">
        <div class="card-body py-3">
          <div class="stat-icon-sm bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-2">
            <i class="bi bi-bookmark fs-5"></i>
          </div>
          <div class="fs-3 fw-bold text-warning"><%= stats.savedCount %></div>
          <div class="text-muted small"><a href="/saved" class="text-decoration-none text-warning">Saved Items</a></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-1 text-center">
        <div class="card-body py-3">
          <div class="stat-icon-sm bg-danger bg-opacity-10 text-danger rounded-circle mx-auto mb-2">
            <i class="bi bi-envelope fs-5"></i>
          </div>
          <div class="fs-3 fw-bold text-danger"><%= stats.unreadCount %></div>
          <div class="text-muted small"><a href="/inquiries" class="text-decoration-none text-danger">Unread Inquiries</a></div>
        </div>
      </div>
    </div>
  </div>

  <!-- My Listings Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0">My Listings</h6>
      <a href="/listings/new" class="btn btn-outline-primary btn-sm">+ New</a>
    </div>
    <div class="card-body p-0">
      <% if (myListings.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-box fs-1 d-block mb-3"></i>
          <p>You haven't listed anything yet.</p>
          <a href="/listings/new" class="btn btn-primary">Post Your First Listing</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-4 py-3">Item</th>
                <th>Price</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% myListings.forEach(item => { %>
                <tr>
                  <td class="ps-4">
                    <div class="d-flex align-items-center gap-3">
                      <% const img = item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder.png'; %>
                      <img src="<%= img %>" class="rounded-3" style="width:48px;height:48px;object-fit:cover;" onerror="this.src='/images/placeholder.png'">
                      <div>
                        <div class="fw-semibold text-truncate" style="max-width:200px;"><%= item.title %></div>
                        <div class="text-muted small"><%= item.category %></div>
                      </div>
                    </div>
                  </td>
                  <td class="fw-semibold text-primary"><%= formatPrice(item.price) %></td>
                  <td>
                    <span class="badge <%= item.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                      <%= item.status === 'active' ? 'Active' : 'Sold' %>
                    </span>
                  </td>
                  <td class="text-muted small"><%= formatDate(item.createdAt) %></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <a href="/listings/<%= item._id %>" class="btn btn-outline-primary btn-sm">View</a>
                      <a href="/listings/<%= item._id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
                      <% if (item.status === 'active') { %>
                        <form action="/listings/<%= item._id %>/sold" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Mark as sold?')">Sold</button>
                        </form>
                      <% } %>
                      <form action="/listings/<%= item._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this listing?')">Del</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="row g-3 mt-2">
    <div class="col-md-6">
      <a href="/saved" class="card border-0 shadow-sm rounded-4 text-decoration-none quick-link-card">
        <div class="card-body d-flex align-items-center gap-3 p-3">
          <div class="stat-icon-sm bg-warning bg-opacity-10 text-warning rounded-circle">
            <i class="bi bi-bookmark fs-5"></i>
          </div>
          <div><div class="fw-semibold">Saved Items</div><div class="text-muted small"><%= stats.savedCount %> item<%= stats.savedCount !== 1 ? 's' : '' %> saved</div></div>
          <i class="bi bi-chevron-right ms-auto text-muted"></i>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a href="/inquiries" class="card border-0 shadow-sm rounded-4 text-decoration-none quick-link-card">
        <div class="card-body d-flex align-items-center gap-3 p-3">
          <div class="stat-icon-sm bg-danger bg-opacity-10 text-danger rounded-circle">
            <i class="bi bi-envelope fs-5"></i>
          </div>
          <div><div class="fw-semibold">Received Inquiries</div><div class="text-muted small"><%= stats.unreadCount %> unread</div></div>
          <i class="bi bi-chevron-right ms-auto text-muted"></i>
        </div>
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
