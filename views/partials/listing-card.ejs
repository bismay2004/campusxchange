<%
// listing-card.ejs — Reusable listing card. Pass `listing` object.
const imgSrc = listing.images && listing.images.length > 0
  ? listing.images[0]
  : "/images/placeholder.png";
const conditionColor = { "New": "success", "Like New": "info", "Good": "warning", "Fair": "secondary" }[listing.condition] || "secondary";
%>
<div class="card h-100 border-0 shadow-sm listing-card">
  <div class="listing-card-img-wrap">
    <img src="<%= imgSrc %>" class="card-img-top listing-card-img" alt="<%= listing.title %>"
         onerror="this.src='/images/placeholder.png'">
    <% if (listing.status === "sold") { %>
      <div class="sold-overlay"><span class="badge bg-danger fs-6">SOLD</span></div>
    <% } %>
    <span class="badge bg-primary position-absolute top-0 end-0 m-2"><%= listing.category %></span>
  </div>
  <div class="card-body p-3">
    <h6 class="card-title fw-bold mb-1 text-truncate"><%= listing.title %></h6>
    <div class="d-flex align-items-center justify-content-between mb-2">
      <span class="text-primary fw-bold fs-5"><%= formatPrice(listing.price) %></span>
      <span class="badge bg-<%= conditionColor %>-subtle text-<%= conditionColor %> border border-<%= conditionColor %>-subtle small">
        <%= listing.condition %>
      </span>
    </div>
    <p class="text-muted small mb-2"><%= truncate(listing.description, 60) %></p>
    <% if (listing.seller) { %>
      <p class="text-muted small mb-0">
        <i class="bi bi-person me-1"></i><%= listing.seller.name %>
        <% if (listing.seller.branch) { %><span class="text-muted">· <%= listing.seller.branch %></span><% } %>
      </p>
    <% } %>
  </div>
  <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
    <a href="/listings/<%= listing._id %>" class="btn btn-outline-primary btn-sm w-100">View Details</a>
  </div>
</div>
