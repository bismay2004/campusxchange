<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusXchange</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/navbar') %>
<%- include('partials/flash') %>
<div class="container py-4">
  <h4 class="fw-bold mb-1">Saved Items</h4>
  <p class="text-muted mb-4">Items you've bookmarked</p>
  <% if (saved.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-bookmark fs-1 text-muted d-block mb-3"></i>
      <h5 class="fw-semibold">Nothing saved yet</h5>
      <p class="text-muted">Browse the marketplace and save items you're interested in.</p>
      <a href="/listings" class="btn btn-primary">Browse Marketplace</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% saved.forEach(s => { %>
        <% if (s.listing) { %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm listing-card">
              <div class="listing-card-img-wrap">
                <% const imgSrc = s.listing.images && s.listing.images.length > 0 ? s.listing.images[0].replace(/\\/g, '/') : '/images/placeholder.png'; %>
                <img src="<%= imgSrc %>" class="card-img-top listing-card-img" alt="<%= s.listing.title %>" onerror="this.src='/images/placeholder.png'">
                <% if (s.listing.status === 'sold') { %>
                  <div class="sold-overlay"><span class="badge bg-danger">SOLD</span></div>
                <% } %>
              </div>
              <div class="card-body p-3">
                <h6 class="fw-bold text-truncate mb-1"><%= s.listing.title %></h6>
                <div class="text-primary fw-bold mb-2"><%= formatPrice(s.listing.price) %></div>
                <div class="small text-muted"><%= s.listing.condition %> &nbsp;·&nbsp; <%= s.listing.category %></div>
              </div>
              <div class="card-footer bg-white border-0 pt-0 pb-3 px-3 d-flex gap-2">
                <a href="/listings/<%= s.listing._id %>" class="btn btn-outline-primary btn-sm flex-grow-1">View</a>
                <form action="/listings/<%= s.listing._id %>/unsave" method="POST">
                  <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove">
                    <i class="bi bi-bookmark-x"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
