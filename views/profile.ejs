<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — CampusXchange</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/navbar') %>
<%- include('partials/flash') %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-5 text-center">
          <div class="avatar-xl bg-primary text-white rounded-circle fw-bold d-flex align-items-center justify-content-center mx-auto mb-4" style="font-size:2.5rem;">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <h4 class="fw-bold mb-0"><%= user.name %></h4>
          <p class="text-muted mb-4"><%= user.email %></p>
          <div class="row g-3 text-start">
            <div class="col-6">
              <div class="bg-light rounded-3 p-3 text-center">
                <div class="text-muted small mb-1">Branch</div>
                <div class="fw-bold"><%= user.branch %></div>
              </div>
            </div>
            <div class="col-6">
              <div class="bg-light rounded-3 p-3 text-center">
                <div class="text-muted small mb-1">Batch</div>
                <div class="fw-bold"><%= user.batch %></div>
              </div>
            </div>
            <div class="col-12">
              <div class="bg-light rounded-3 p-3 text-center">
                <div class="text-muted small mb-1">Member Since</div>
                <div class="fw-bold"><%= formatDate(user.createdAt) %></div>
              </div>
            </div>
          </div>
          <div class="d-grid gap-2 mt-4">
            <a href="/dashboard" class="btn btn-primary">
              <i class="bi bi-grid me-2"></i>Go to Dashboard
            </a>
            <a href="/listings/new" class="btn btn-outline-success">
              <i class="bi bi-plus me-2"></i>Post a Listing
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
