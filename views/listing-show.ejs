<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= listing.title %> — CampusXchange</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none">Marketplace</a></li>
      <li class="breadcrumb-item"><a href="/listings?category=<%= listing.category %>" class="text-decoration-none"><%= listing.category %></a></li>
      <li class="breadcrumb-item active text-truncate" style="max-width:200px;"><%= listing.title %></li>
    </ol>
  </nav>

  <% if (listing.status === "sold") { %>
    <div class="alert alert-danger border-0 rounded-3 mb-4 d-flex align-items-center">
      <i class="bi bi-bag-x-fill me-2 fs-5"></i>
      <div>This item has been <strong>sold</strong> and is no longer available.</div>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- LEFT — IMAGE GALLERY -->
    <div class="col-lg-6">
      <% const imgs = listing.images && listing.images.length > 0 ? listing.images : ["/images/placeholder.png"]; %>
      <div class="mb-3 position-relative">
        <img id="mainImage" src="<%= imgs[0] %>"
             class="img-fluid rounded-4 w-100 main-product-img"
             alt="<%= listing.title %>"
             onerror="this.src='/images/placeholder.png'">
        <% if (listing.status === "sold") { %>
          <div class="sold-overlay-absolute rounded-4">
            <span class="badge bg-danger px-3 py-2 fs-6">SOLD</span>
          </div>
        <% } %>
      </div>
      <% if (imgs.length > 1) { %>
        <div class="d-flex gap-2 flex-wrap">
          <% imgs.forEach((img, i) => { %>
            <img src="<%= img %>"
                 class="thumbnail-img rounded-3 <%= i === 0 ? 'active' : '' %>"
                 onclick="switchImage(this, '<%= img %>')"
                 alt="Image <%= i + 1 %>"
                 onerror="this.src='/images/placeholder.png'">
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- RIGHT — LISTING DETAILS -->
    <div class="col-lg-6">
      <h2 class="fw-bold mb-1"><%= listing.title %></h2>
      <div class="display-6 fw-bold text-primary mb-3"><%= formatPrice(listing.price) %></div>

      <!-- Status + Meta Badges -->
      <div class="d-flex flex-wrap gap-2 mb-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
          <i class="bi bi-tag me-1"></i><%= listing.category %>
        </span>
        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
          <i class="bi bi-stars me-1"></i><%= listing.condition %>
        </span>
        <span class="badge <%= listing.status === 'active' ? 'bg-success' : 'bg-danger' %> px-3 py-2">
          <%= listing.status === 'active' ? 'Available' : 'Sold' %>
        </span>
      </div>

      <!-- Description -->
      <div class="mb-4">
        <h6 class="fw-bold">Description</h6>
        <p class="text-muted" style="white-space:pre-line;"><%= listing.description %></p>
      </div>

      <!-- Item Details Grid -->
      <div class="row g-2 mb-4">
        <% if (listing.branch) { %>
          <div class="col-6">
            <div class="bg-light rounded-3 p-3">
              <div class="text-muted small mb-1">Seller Branch</div>
              <div class="fw-semibold"><%= listing.branch %></div>
            </div>
          </div>
        <% } %>
        <% if (listing.batch) { %>
          <div class="col-6">
            <div class="bg-light rounded-3 p-3">
              <div class="text-muted small mb-1">Batch</div>
              <div class="fw-semibold"><%= listing.batch %></div>
            </div>
          </div>
        <% } %>
        <% if (listing.location) { %>
          <div class="col-6">
            <div class="bg-light rounded-3 p-3">
              <div class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i>Location</div>
              <div class="fw-semibold"><%= listing.location %></div>
            </div>
          </div>
        <% } %>
        <div class="col-6">
          <div class="bg-light rounded-3 p-3">
            <div class="text-muted small mb-1">Listed On</div>
            <div class="fw-semibold"><%= formatDate(listing.createdAt) %></div>
          </div>
        </div>
      </div>

      <!-- ── ACTION BUTTONS ──────────────────────────────── -->

      <% if (myInquiry && myInquiry.response === 'accepted') { %>
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center">
          <i class="bi bi-envelope-open-fill me-2 fs-5"></i>
          <div>
            Seller accepted your inquiry. Please connect via email: <strong><%= listing.seller.email %></strong>
            <div class="small text-muted">Send a message to this email to continue the transaction.</div>
          </div>
        </div>
      <% } %>

      <% if (!user) { %>
        <!-- Visitor — prompt to log in -->
        <div class="d-grid gap-2">
          <a href="/login" class="btn btn-primary btn-lg">
            <i class="bi bi-person me-2"></i>Login to Contact Seller
          </a>
          <a href="/login" class="btn btn-outline-secondary">
            <i class="bi bi-bookmark me-2"></i>Login to Save this Item
          </a>
        </div>

      <% } else if (isOwner) { %>
        <!-- Listing owner actions -->
        <div class="d-grid gap-2">
          <% if (listing.status === "active") { %>
            <button class="btn btn-success btn-lg" data-bs-toggle="modal" data-bs-target="#soldModal">
              <i class="bi bi-check-circle me-2"></i>Mark as Sold
            </button>
          <% } else { %>
            <div class="d-grid gap-2">
              <div class="alert alert-secondary mb-2 text-center">
                <i class="bi bi-bag-check me-2"></i>This listing is marked as sold.
              </div>
              <button class="btn btn-outline-success btn-lg" data-bs-toggle="modal" data-bs-target="#unsoldModal">
                <i class="bi bi-arrow-counterclockwise me-2"></i>Mark as Available
              </button>
            </div>
          <% } %>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary flex-grow-1">
              <i class="bi bi-pencil me-1"></i>Edit Listing
            </a>
            <button class="btn btn-outline-danger flex-grow-1" data-bs-toggle="modal" data-bs-target="#deleteModal">
              <i class="bi bi-trash me-1"></i>Delete
            </button>
          </div>
          <p class="text-muted small text-center mb-0">This is your listing.</p>
        </div>

      <% } else { %>
        <!-- Buyer / Non-owner actions -->
        <div class="d-grid gap-2">
          <% if (listing.status === "active") { %>
            <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#inquiryModal">
              <i class="bi bi-chat-dots me-2"></i>Contact Seller
            </button>
          <% } else { %>
            <button class="btn btn-secondary btn-lg" disabled>
              <i class="bi bi-x-circle me-2"></i>Item Sold — Contact Unavailable
            </button>
          <% } %>

          <% if (isSaved) { %>
            <form action="/listings/<%= listing._id %>/unsave" method="POST">
              <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="bi bi-bookmark-fill me-2"></i>Remove from Saved Items
              </button>
            </form>
          <% } else { %>
            <form action="/listings/<%= listing._id %>/save" method="POST">
              <button type="submit" class="btn btn-outline-primary w-100">
                <i class="bi bi-bookmark me-2"></i>Save this Item
              </button>
            </form>
          <% } %>

          <div class="text-center">
            <button class="btn btn-link text-muted small text-decoration-none"
                    data-bs-toggle="modal" data-bs-target="#reportModal">
              <i class="bi bi-flag me-1"></i>Report this listing
            </button>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- SELLER INFO -->
  <div class="card border-0 shadow-sm rounded-4 mt-4">
    <div class="card-body p-4">
      <h6 class="fw-bold mb-3">About the Seller</h6>
      <div class="d-flex align-items-center gap-3">
        <% if (listing.seller.avatar) { %>
          <img src="<%= listing.seller.avatar %>" class="avatar-lg rounded-circle flex-shrink-0" style="width:56px;height:56px;object-fit:cover;" alt="<%= listing.seller.name %>"/>
        <% } else { %>
          <div class="avatar-lg bg-primary text-white rounded-circle fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="font-size:1.5rem;">
            <%= listing.seller.name.charAt(0).toUpperCase() %>
          </div>
        <% } %>
        <div>
          <div class="fw-bold fs-5"><%= listing.seller.name %></div>
          <div class="text-muted small">
            <%= listing.seller.branch %> &nbsp;&middot;&nbsp; Batch <%= listing.seller.batch %>
          </div>
          <div class="text-muted small">Member since <%= formatDate(listing.seller.createdAt) %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ MODALS — all inside body, rendered conditionally ══════ -->

<% if (!user) { %>
  <!-- No modals for visitors -->

<% } else if (isOwner) { %>

  <!-- DELETE MODAL — owner only -->
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 rounded-4">
        <div class="modal-body text-center p-4">
          <i class="bi bi-exclamation-triangle-fill text-warning fs-1 mb-3 d-block"></i>
          <h6 class="fw-bold" id="deleteModalLabel">Delete this listing?</h6>
          <p class="text-muted small mb-4">This cannot be undone. All related inquiries and saves will also be removed.</p>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <div class="d-flex gap-2 justify-content-center">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">Yes, Delete</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MARK SOLD MODAL — owner only, active listings only -->
  <% if (listing.status === "active") { %>
  <div class="modal fade" id="soldModal" tabindex="-1" aria-labelledby="soldModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 rounded-4">
        <div class="modal-body text-center p-4">
          <i class="bi bi-bag-check-fill text-success fs-1 mb-3 d-block"></i>
          <h6 class="fw-bold" id="soldModalLabel">Mark as Sold?</h6>
          <p class="text-muted small mb-4">
            This will remove the listing from the active marketplace.
            Buyers will no longer be able to contact you about this item.
          </p>
          <form action="/listings/<%= listing._id %>/sold" method="POST">
            <div class="d-flex gap-2 justify-content-center">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-success">Yes, Mark as Sold</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <% if (listing.status === "sold") { %>
  <div class="modal fade" id="unsoldModal" tabindex="-1" aria-labelledby="unsoldModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 rounded-4">
        <div class="modal-body text-center p-4">
          <i class="bi bi-arrow-counterclockwise text-success fs-1 mb-3 d-block"></i>
          <h6 class="fw-bold" id="unsoldModalLabel">Mark as Available?</h6>
          <p class="text-muted small mb-4">
            This will make the listing visible again in the marketplace and allow buyers to contact you.
          </p>
          <form action="/listings/<%= listing._id %>/unsold" method="POST">
            <div class="d-flex gap-2 justify-content-center">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-success">Yes, Mark as Available</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <% } %>

<% } else { %>

  <!-- INQUIRY MODAL — buyer only, active listing only -->
  <% if (listing.status === "active") { %>
  <div class="modal fade" id="inquiryModal" tabindex="-1" aria-labelledby="inquiryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-4">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="inquiryModalLabel">Contact Seller</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/listings/<%= listing._id %>/inquiries" method="POST">
          <div class="modal-body p-4">
            <p class="text-muted small mb-3">
              Your message will be sent to <strong><%= listing.seller.name %></strong>.
              The seller will respond to you via the inquiries system.
            </p>
            <div class="mb-0">
              <label class="form-label fw-semibold small">Your Message</label>
              <textarea name="message" class="form-control" rows="4" maxlength="500" required
                placeholder="Hi, I'm interested in this item. Is it still available?">Hi, I'm interested in this item. Is it still available?</textarea>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-send me-1"></i>Send Inquiry
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <% } %>

  <!-- REPORT MODAL — buyer only -->
  <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-4">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="reportModalLabel">Report Listing</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/listings/<%= listing._id %>/report" method="POST">
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-semibold small">Reason <span class="text-danger">*</span></label>
              <select name="reason" class="form-select" required>
                <option value="">Select a reason</option>
                <% ["Fake listing","Incorrect information","Spam","Inappropriate content","Other"].forEach(r => { %>
                  <option value="<%= r %>"><%= r %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-0">
              <label class="form-label fw-semibold small">Additional details (optional)</label>
              <textarea name="message" class="form-control" rows="3" maxlength="300"
                        placeholder="Any additional context that will help us review..."></textarea>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Submit Report</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
// Thumbnail gallery switcher
function switchImage(thumb, src) {
  document.getElementById("mainImage").src = src;
  document.querySelectorAll(".thumbnail-img").forEach(t => t.classList.remove("active"));
  thumb.classList.add("active");
}
</script>
</body>
</html>
