<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Marketplace — CampusXchange</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<%
// Build pagination URL — EJS server-side helper (no browser APIs needed)
function pageUrl(p) {
  const params = [];
  if (filters.search)    params.push('search='    + encodeURIComponent(filters.search));
  if (filters.category)  params.push('category='  + encodeURIComponent(filters.category));
  if (filters.condition) params.push('condition=' + encodeURIComponent(filters.condition));
  if (filters.price)     params.push('price='     + encodeURIComponent(filters.price));
  if (filters.sort)      params.push('sort='      + encodeURIComponent(filters.sort));
  params.push('page=' + p);
  return '/listings?' + params.join('&');
}
%>

<div class="container-fluid py-4">
  <div class="row g-4">

    <!-- FILTERS SIDEBAR -->
    <div class="col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 sticky-top filter-card" style="top:76px;">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Filter Listings</h6>
            <% if (filters.search || filters.category || filters.condition || filters.price || filters.sort) { %>
              <a href="/listings" class="small text-primary text-decoration-none">Clear all</a>
            <% } %>
          </div>
          <form action="/listings" method="GET" id="filterForm">
            <div class="mb-3">
              <label class="form-label fw-semibold small">Search</label>
              <input type="text" name="search" class="form-control" placeholder="Keywords..." value="<%= filters.search %>">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Category</label>
              <select name="category" class="form-select">
                <option value="">All Categories</option>
                <% CATEGORIES.forEach(cat => { %>
                  <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Condition</label>
              <select name="condition" class="form-select">
                <option value="">Any Condition</option>
                <% CONDITIONS.forEach(c => { %>
                  <option value="<%= c %>" <%= filters.condition === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Price Range</label>
              <select name="price" class="form-select">
                <option value="">Any Price</option>
                <option value="under500"   <%= filters.price === 'under500'   ? 'selected' : '' %>>Under ₹500</option>
                <option value="500to1000"  <%= filters.price === '500to1000'  ? 'selected' : '' %>>₹500 – ₹1,000</option>
                <option value="1000to5000" <%= filters.price === '1000to5000' ? 'selected' : '' %>>₹1,000 – ₹5,000</option>
                <option value="above5000"  <%= filters.price === 'above5000'  ? 'selected' : '' %>>₹5,000+</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold small">Sort By</label>
              <select name="sort" class="form-select">
                <option value=""           <%= !filters.sort              ? 'selected' : '' %>>Newest First</option>
                <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-2">Apply Filters</button>
            <a href="/listings" class="btn btn-outline-secondary w-100 btn-sm">Clear All</a>
          </form>
        </div>
      </div>
    </div>

    <!-- LISTINGS GRID -->
    <div class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h5 class="fw-bold mb-0">
            <% if (filters.search) { %>Results for "<%= filters.search %>"<% } else if (filters.category) { %><%= filters.category %><% } else { %>All Listings<% } %>
            <% if (filters.category && filters.search) { %><span class="badge bg-primary ms-2"><%= filters.category %></span><% } %>
          </h5>
          <p class="text-muted small mb-0"><%= total %> active item<%= total !== 1 ? 's' : '' %> found</p>
        </div>
        <% if (user) { %>
          <a href="/listings/new" class="btn btn-success btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i>Post a Listing
          </a>
        <% } %>
      </div>

      <% if (listings.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
          <h5 class="fw-semibold">No listings found</h5>
          <p class="text-muted">Try different keywords or remove some filters.</p>
          <a href="/listings" class="btn btn-outline-primary">Clear Filters</a>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% listings.forEach(listing => { %>
            <div class="col-sm-6 col-md-4">
              <%- include('partials/listing-card', { listing }) %>
            </div>
          <% }) %>
        </div>

        <!-- PAGINATION — uses server-side pageUrl() function, no browser API -->
        <% if (totalPages > 1) { %>
          <nav class="mt-5 d-flex justify-content-center">
            <ul class="pagination">
              <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="<%= pageUrl(currentPage - 1) %>" aria-label="Previous">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>
              <% for (let p = 1; p <= totalPages; p++) { %>
                <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                  <a class="page-link" href="<%= pageUrl(p) %>"><%= p %></a>
                </li>
              <% } %>
              <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="<%= pageUrl(currentPage + 1) %>" aria-label="Next">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
            </ul>
          </nav>
        <% } %>
      <% } %>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
